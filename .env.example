LLM_PROVIDER=ollama

# ---- OpenAI（LLM_PROVIDER=openai 时必填）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 兼容第三方网关时填，例如 https://api.deepseek.com/v1
OPENAI_BASE_URL=

# ---- Ollama（LLM_PROVIDER=ollama 时必填）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# 嵌入模型：ollama 用 nomic-embed-text / mxbai-embed-large；openai 用 text-embedding-3-small
EMBEDDING_MODEL=nomic-embed-text

# ---- 文档与索引 ----
DOCS_DIR=docs
STORE_DIR=.feilian
# 同一 store 下多套知识库，可换集合名区分
COLLECTION=feilian

# ---- 切块 ----
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ---- 检索 ----
TOP_K=4
FETCH_K=20
# similarity 或 mmr；留空/NONE 表示不做阈值过滤
SEARCH_TYPE=similarity
SCORE_THRESHOLD=0.2

# ---- 会话 ----
HISTORY_TURNS=6
TEMPERATURE=0
